---
import Base from '../layouts/Base.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { Image, getImage } from 'astro:assets';
import { ATELIER, GROUPES_ATELIER } from '../config/galerie';
// Mobile : médias regroupés par projet ; tout média oublié dans un groupe part dans « Autres réalisations ».
const parLegende = new Map(ATELIER.map((m) => [m.legende, m]));
const ranges = new Set(GROUPES_ATELIER.flatMap((g) => g.legendes));
const groupes = [
  ...GROUPES_ATELIER.map((g) => ({ titre: g.titre, medias: g.legendes.map((l) => parLegende.get(l)).filter((m) => m !== undefined) })),
  { titre: 'Autres réalisations', medias: ATELIER.filter((m) => !ranges.has(m.legende)) },
].filter((g) => g.medias.length);
// Visionneuse : chaque projet devient une pile de tirages ; les médias en grand format sont préparés au build.
const piles = await Promise.all(groupes.map(async (g) => ({
  titre: g.titre,
  medias: await Promise.all(g.medias.map(async (m) => m.type === 'photo'
    ? { type: 'photo', src: (await getImage({ src: m.src, width: 1600, format: 'webp' })).src, alt: m.alt, legende: m.legende }
    : { type: 'video', src: m.mp4, poster: m.poster, alt: m.alt, legende: m.legende })),
})));
const INCLINAISONS = [-3, 2.5, -1.5, 3.5, -2.5, 1.5, -3.5, 2];
import Modeles3D from '../components/Modeles3D.astro';
import SwitchEclate from '../components/SwitchEclate.astro';
---
<Base title="Réalisations en impression et modélisation 3D | Kov Atelier" description="Modèles 3D conçus et sculptés à l’atelier, et photos de pièces imprimées en résine et en filament par Kov Atelier à Florange (Moselle).">
  <section class="page-head page-head--switch"><div class="wrap">
    <SwitchEclate />
  </div></section>

  <section class="section real-section" id="modeles-3d" aria-labelledby="t-modeles">
    <div class="wrap">
      <div class="section-head">
        <h2 id="t-modeles">Modèles 3D</h2>
        <p>La bibliothèque des modèles conçus à l’atelier : pièces techniques, sculptures et figurines, chacune présentée en rotation à 360°.</p>
      </div>
      <Modeles3D filtres />
    </div>
  </section>

  <section class="section real-section" id="bustes" aria-labelledby="t-bustes">
    <div class="wrap bustes-grille">
      <div class="bustes-texte">
        <h2 id="t-bustes">Bustes d’après photo</h2>
        <p>Un buste qui ressemble vraiment à la personne : chaque visage est sculpté à la main dans ZBrush, à partir de vos photos, sans génération automatique. Il est ensuite imprimé en résine et fini à l’atelier.</p>
        <ul class="bustes-etapes">
          <li>Vous envoyez une ou plusieurs photos</li>
          <li>Le visage est sculpté numériquement, vous validez le modèle</li>
          <li>Le buste est imprimé, fini et expédié</li>
        </ul>
        <a class="btn btn-primary" href="/devis?prestation=artistique" data-cta="bustes">Demander un devis pour un buste</a>
      </div>
      <figure class="bustes-video">
        <video id="video-bustes" data-boucle muted loop playsinline preload="metadata" poster="/videos/bustes/buste-d-apres-photo.jpg" aria-label="Vidéo de présentation : un buste sculpté d’après une photo ancienne, puis le sculpteur au travail">
          <source src="/videos/bustes/buste-d-apres-photo.mp4" type="video/mp4" />
        </video>
        <button type="button" class="bustes-son" data-son aria-pressed="false">Activer le son</button>
      </figure>
    </div>
  </section>

  <section class="section real-section" id="en-vrai" aria-labelledby="t-vrai">
    <div class="wrap">
      <div class="section-head">
        <h2 id="t-vrai">En vrai, à l’atelier</h2>
        <p>Les pièces imprimées, finies et montées : résine, filament, finitions, et quelques coulisses de fabrication.</p>
      </div>
      <p class="piles-aide">Survolez une pile pour l’ouvrir, cliquez pour voir les photos en grand.</p>
      <ul class="piles">
        {groupes.map((g, gi) => (
          <li class="pile" style={`--r:${INCLINAISONS[gi % INCLINAISONS.length]}deg`} data-n={g.medias.length}>
            <button type="button" class="pile-btn" data-pile={gi} aria-label={`${g.titre} : voir ${g.medias.length > 1 ? `les ${g.medias.length} photos` : 'la photo'} en grand`}>
              <span class="pile-cartes" aria-hidden="true">
                {g.medias.slice(0, 3).map((m, k) => (
                  <span class="carte" style={`--k:${k}`}>
                    {m.type === 'photo'
                      ? <Image src={m.src} alt="" widths={[360, 560]} sizes="(max-width: 600px) 80vw, 300px" loading="lazy" />
                      : <img src={m.poster} alt="" loading="lazy" decoding="async" />}
                    {m.type === 'video' && <span class="carte-lecture">▶</span>}
                  </span>
                ))}
              </span>
            </button>
            <p class="pile-titre">{g.titre}<span>{g.medias.length > 1 ? `${g.medias.length} photos` : '1 photo'}</span></p>
          </li>
        ))}
      </ul>

      <dialog class="visionneuse" id="visionneuse" aria-labelledby="v-titre">
        <div class="v-tete">
          <p class="v-titre" id="v-titre"></p>
          <p class="v-compte" aria-live="polite"></p>
          <button type="button" class="v-fermer" data-v="fermer" aria-label="Fermer">×</button>
        </div>
        <div class="v-scene">
          <button type="button" class="v-nav v-prec" data-v="prec" aria-label="Photo précédente">‹</button>
          <figure class="v-media"></figure>
          <button type="button" class="v-nav v-suiv" data-v="suiv" aria-label="Photo suivante">›</button>
        </div>
        <p class="v-legende"></p>
        <div class="v-vignettes"></div>
      </dialog>
      <script type="application/json" id="piles-donnees" set:html={JSON.stringify(piles)} />
    </div>
  </section>

  <CtaFinal titre="Un projet comparable ?" source="realisations-final" />
  <script is:inline>
    // Piles de tirages : sur téléphone, la pile qui passe au milieu de l'écran s'ouvre en éventail.
    // Au clic ou au toucher : visionneuse plein écran, flèches, clavier, glissement du doigt, vignettes.
    (function () {
      var donnees = JSON.parse((document.getElementById('piles-donnees') || {}).textContent || '[]');
      var dlg = document.getElementById('visionneuse');
      if (!dlg || !donnees.length) return;
      var mq = window.matchMedia('(hover: none)');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.target.classList.toggle('en-vue', mq.matches && e.isIntersecting); });
        }, { rootMargin: '-38% 0px -38% 0px' });
        document.querySelectorAll('.pile').forEach(function (p) { io.observe(p); });
      }
      var media = dlg.querySelector('.v-media'), legende = dlg.querySelector('.v-legende'), titre = dlg.querySelector('.v-titre'),
          compte = dlg.querySelector('.v-compte'), vignettes = dlg.querySelector('.v-vignettes'), pile = 0, i = 0;
      function montrer(k) {
        var liste = donnees[pile].medias; i = (k + liste.length) % liste.length; var m = liste[i];
        media.replaceChildren();
        var el;
        if (m.type === 'photo') { el = new Image(); el.src = m.src; el.alt = m.alt; el.decoding = 'async'; }
        else { el = document.createElement('video'); el.src = m.src; el.poster = m.poster; el.muted = true; el.loop = true; el.playsInline = true; el.controls = true; el.autoplay = true; el.setAttribute('aria-label', m.alt); }
        media.appendChild(el);
        legende.textContent = m.legende;
        compte.textContent = liste.length > 1 ? (i + 1) + ' / ' + liste.length : '';
        dlg.classList.toggle('v-seule', liste.length < 2);
        vignettes.querySelectorAll('button').forEach(function (b, k2) { b.setAttribute('aria-current', String(k2 === i)); });
      }
      function ouvrir(p) {
        pile = p; titre.textContent = donnees[p].titre;
        vignettes.replaceChildren.apply(vignettes, donnees[p].medias.map(function (m, k) {
          var b = document.createElement('button'); b.type = 'button'; b.className = 'v-vignette'; b.setAttribute('aria-label', 'Photo ' + (k + 1));
          var im = new Image(); im.src = m.type === 'photo' ? m.src : m.poster; im.alt = ''; im.loading = 'lazy'; b.appendChild(im);
          b.addEventListener('click', function () { montrer(k); }); return b;
        }));
        montrer(0); dlg.showModal();
      }
      document.querySelectorAll('[data-pile]').forEach(function (b) { b.addEventListener('click', function () { ouvrir(+b.dataset.pile); }); });
      dlg.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('[data-v]');
        if (a) { var v = a.dataset.v; if (v === 'fermer') dlg.close(); else montrer(i + (v === 'suiv' ? 1 : -1)); return; }
        if (e.target === dlg) dlg.close();
      });
      dlg.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') montrer(i + 1); if (e.key === 'ArrowLeft') montrer(i - 1); });
      dlg.addEventListener('close', function () { media.replaceChildren(); });
      var x0 = null;
      media.addEventListener('pointerdown', function (e) { x0 = e.clientX; });
      media.addEventListener('pointerup', function (e) { if (x0 === null) return; var dx = e.clientX - x0; x0 = null; if (Math.abs(dx) > 45) montrer(i + (dx < 0 ? 1 : -1)); });
    })();
    (function () {
      var b = document.querySelector('[data-son]'); var v = document.getElementById('video-bustes');
      if (!b || !v) return;
      b.addEventListener('click', function () {
        v.muted = !v.muted;
        if (!v.muted) { v.currentTime = 0; v.play().catch(function () {}); }
        b.setAttribute('aria-pressed', String(!v.muted));
        b.textContent = v.muted ? 'Activer le son' : 'Couper le son';
      });
    })();
  </script>
</Base>
