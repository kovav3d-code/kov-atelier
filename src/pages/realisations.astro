---
import Base from '../layouts/Base.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { Image } from 'astro:assets';
import { MODELES, ATELIER } from '../config/galerie';
---
<Base title="Réalisations en impression et modélisation 3D | Kov Atelier" description="Modèles 3D conçus et sculptés à l’atelier, et photos de pièces imprimées en résine et en filament par Kov Atelier à Florange (Moselle).">
  <section class="page-head"><div class="wrap">
    <h1>Nos réalisations</h1>
    <p class="lead">Les modèles 3D conçus à l’atelier, puis les pièces bien réelles qui en sortent.</p>
    <nav class="real-nav" aria-label="Sections de la page">
      <a href="#modeles-3d">Modèles 3D</a>
      <a href="#en-vrai">Photos et vidéos de l’atelier</a>
    </nav>
  </div></section>

  <section class="section real-section" id="modeles-3d" aria-labelledby="t-modeles">
    <div class="wrap">
      <div class="section-head">
        <h2 id="t-modeles">Modèles 3D</h2>
        <p>Pièces techniques, sculptures et figurines modélisées à l’atelier. Chaque modèle tourne sur lui-même : faites-le pivoter au doigt ou à la souris.</p>
      </div>
      <ul class="modeles-grille">
        {MODELES.map((m) => (
          <li class="modele">
            <div class="modele-scene">
              {m.fichier ? (
                <div class="modele-canvas" data-modele-3d data-fichier={m.fichier} data-couleur={m.couleur} role="img" aria-label={m.alt}></div>
              ) : m.video && (
                <video data-boucle muted loop playsinline preload="metadata" poster={m.video.poster} aria-label={m.alt}>
                  <source src={m.video.mp4} type="video/mp4" />
                </video>
              )}
              <span class="modele-badge" aria-hidden="true">360°</span>
            </div>
            <p class="modele-titre">{m.titre}</p>
            {m.legende && <p class="modele-legende">{m.legende}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section real-section" id="en-vrai" aria-labelledby="t-vrai">
    <div class="wrap">
      <div class="section-head">
        <h2 id="t-vrai">En vrai, à l’atelier</h2>
        <p>Les pièces imprimées, finies et montées : résine, filament, finitions, et quelques coulisses de fabrication.</p>
      </div>
      <ul class="atelier-mur">
        {ATELIER.map((m, i) => (
          <li class="atelier-item">
            <figure>
              {m.type === 'photo' ? (
                <Image src={m.src} alt={m.alt} widths={[400, 700, 1000]} sizes="(max-width: 600px) 100vw, (max-width: 960px) 50vw, 380px" loading={i < 3 ? 'eager' : 'lazy'} />
              ) : (
                <video data-boucle muted loop playsinline preload="metadata" poster={m.poster} aria-label={m.alt}>
                  <source src={m.mp4} type="video/mp4" />
                </video>
              )}
              <figcaption>{m.legende}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaFinal titre="Un projet comparable ?" source="realisations-final" />
</Base>
<script is:inline type="module" src="/scripts/visionneuse-3d.js"></script>
