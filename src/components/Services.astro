---
import Icon from './Icon.astro';
import { SERVICES } from '../config/services';
---
<div class="services-grid">
  {SERVICES.map((s) => (
    <article class="service">
      <Icon name={s.icon} />
      <h3>{s.titre}</h3>
      <p>{s.resume}</p>
      <p class="service-prix">À partir de <strong>{s.prix}</strong>{'prixUnite' in s && s.prixUnite ? ` ${s.prixUnite}` : ''}</p>
      <a class="link" href={`/services#${s.id}`}>En savoir plus<span class="sr-only"> sur {s.titre.toLowerCase()}</span></a>
    </article>
  ))}
</div>
