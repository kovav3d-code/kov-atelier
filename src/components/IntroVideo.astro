---
// Vidéo d'introduction jouée en fond du hero, derrière le texte (visible dès le départ).
// Une fois par session ; ignorée si l'utilisateur limite les animations ou économise ses données.
// N'apparaît que si les deux vidéos existent dans public/videos (vérifié au build).
import fs from 'node:fs';
import path from 'node:path';

const PORTRAIT = '/videos/intro-portrait.mp4';
const PAYSAGE = '/videos/intro-paysage.mp4';
const existe = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const actif = existe(PORTRAIT) && existe(PAYSAGE);
---
{actif && (
  <div class="hero-video" aria-hidden="true" data-portrait={PORTRAIT} data-paysage={PAYSAGE}>
    <video muted playsinline preload="none"></video>
  </div>
  <script is:inline>
    (function () {
      var bloc = document.currentScript && document.currentScript.previousElementSibling;
      if (!bloc || !bloc.classList.contains('hero-video')) return;
      var hero = bloc.closest('.hero');
      var deja = false;
      try { deja = sessionStorage.getItem('kov-intro') === '1'; } catch (e) {}
      var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var eco = navigator.connection && navigator.connection.saveData;
      if (!hero || deja || reduit || eco) { bloc.remove(); return; }

      var video = bloc.querySelector('video');
      var portrait = window.matchMedia('(max-width: 719px), (orientation: portrait)').matches;
      video.src = portrait ? bloc.dataset.portrait : bloc.dataset.paysage;
      video.preload = 'auto';

      var fini = false;
      function terminer() {
        if (fini) return;
        fini = true;
        try { sessionStorage.setItem('kov-intro', '1'); } catch (e) {}
        hero.classList.add('video-fin');
        hero.classList.remove('video-lecture');
        setTimeout(function () { bloc.remove(); hero.classList.remove('video-fin'); }, 1800);
      }
      video.addEventListener('playing', function () { if (!fini) hero.classList.add('video-lecture'); }, { once: true });
      video.addEventListener('timeupdate', function () {
        if (video.duration && video.duration - video.currentTime < 0.9) terminer();
      });
      video.addEventListener('ended', terminer);
      video.addEventListener('error', terminer);
      var p = video.play();
      if (p && p.catch) p.catch(terminer);
      setTimeout(function () { if (!hero.classList.contains('video-lecture')) terminer(); }, 3000);
      setTimeout(terminer, 9000);
    })();
  </script>
)}
