---
// Introduction animée plein écran, jouée à la première visite de la session.
// N'apparaît que si les deux vidéos existent dans public/videos (vérifié au build).
import fs from 'node:fs';
import path from 'node:path';

const PORTRAIT = '/videos/intro-portrait.mp4';
const PAYSAGE = '/videos/intro-paysage.mp4';
const existe = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const actif = existe(PORTRAIT) && existe(PAYSAGE);
---
{actif && (
  <div class="intro" id="intro" aria-hidden="true" data-portrait={PORTRAIT} data-paysage={PAYSAGE}>
    <video class="intro-video" muted playsinline preload="auto"></video>
    <div class="intro-voile"></div>
    <div class="intro-barre"><span></span></div>
    <button class="intro-passer" type="button" tabindex="-1">Passer</button>
  </div>
  <script is:inline>
    (function () {
      var intro = document.getElementById('intro');
      if (!intro) return;
      var deja = false;
      try { deja = sessionStorage.getItem('kov-intro') === '1'; } catch (e) {}
      var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var eco = navigator.connection && navigator.connection.saveData;
      if (deja || reduit || eco) { intro.remove(); return; }

      var video = intro.querySelector('video');
      var barre = intro.querySelector('.intro-barre span');
      var portrait = window.matchMedia('(orientation: portrait)').matches;
      video.src = portrait ? intro.dataset.portrait : intro.dataset.paysage;
      intro.classList.add('visible');
      document.documentElement.classList.add('intro-active');

      var fini = false;
      function fermer() {
        if (fini) return;
        fini = true;
        try { sessionStorage.setItem('kov-intro', '1'); } catch (e) {}
        intro.classList.add('sortie');
        document.documentElement.classList.remove('intro-active');
        setTimeout(function () { intro.remove(); }, 900);
      }

      video.addEventListener('timeupdate', function () {
        if (video.duration) barre.style.transform = 'scaleX(' + (video.currentTime / video.duration) + ')';
      });
      video.addEventListener('playing', function () { intro.classList.add('lecture'); });
      video.addEventListener('ended', function () { barre.style.transform = 'scaleX(1)'; setTimeout(fermer, 700); });
      video.addEventListener('error', fermer);
      intro.querySelector('.intro-passer').addEventListener('click', fermer);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') fermer(); });
      // Lecture automatique refusée, réseau lent ou vidéo bloquée : on n'attend pas.
      var p = video.play();
      if (p && p.catch) p.catch(fermer);
      setTimeout(function () { if (!intro.classList.contains('lecture')) fermer(); }, 2500);
      setTimeout(fermer, 9000);
    })();
  </script>
)}
