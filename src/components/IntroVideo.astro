---
// Vidéo d'introduction jouée en fond du hero, derrière le texte (visible dès le départ).
// À la fin, le buste « cristallise » : une image fixe où ses contours deviennent du filament PLA
// translucide et lumineux. Cette image reste ensuite en fond du hero.
// Si l'utilisateur limite les animations ou économise ses données : l'image fixe s'affiche directement.
// N'apparaît que si les vidéos et les images existent dans public (vérifié au build).
import fs from 'node:fs';
import path from 'node:path';

const PORTRAIT = '/videos/intro-portrait.mp4';
const PAYSAGE = '/videos/intro-paysage.mp4';
const CRISTAL_PORTRAIT = '/medias/intro-cristal-portrait.jpg';
const CRISTAL_PAYSAGE = '/medias/intro-cristal-paysage.jpg';
const existe = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const actif = [PORTRAIT, PAYSAGE, CRISTAL_PORTRAIT, CRISTAL_PAYSAGE].every(existe);
---
{actif && (
  <div class="hero-video" aria-hidden="true" data-portrait={PORTRAIT} data-paysage={PAYSAGE}>
    <video muted playsinline preload="none"></video>
    <picture>
      <source media="(max-width: 719px), (orientation: portrait)" srcset={CRISTAL_PORTRAIT} />
      <img class="hero-cristal" src={CRISTAL_PAYSAGE} alt="" decoding="async" />
    </picture>
  </div>
  <script is:inline>
    (function () {
      var bloc = document.currentScript && document.currentScript.previousElementSibling;
      if (!bloc || !bloc.classList.contains('hero-video')) return;
      var hero = bloc.closest('.hero');
      if (!hero) return;
      var video = bloc.querySelector('video');
      var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var eco = navigator.connection && navigator.connection.saveData;

      // Sans animation : le buste cristallisé directement.
      if (reduit || eco) { video.remove(); hero.classList.add('cristal-fixe'); return; }

      var portrait = window.matchMedia('(max-width: 719px), (orientation: portrait)').matches;
      video.src = portrait ? bloc.dataset.portrait : bloc.dataset.paysage;
      video.preload = 'auto';

      var fini = false;
      function cristalliser() {
        if (fini) return;
        fini = true;
        hero.classList.add('cristallise');
        setTimeout(function () {
          hero.classList.add('cristal-fixe');
          hero.classList.remove('video-lecture', 'cristallise');
          video.remove();
        }, 1700);
      }
      video.addEventListener('playing', function () { if (!fini) hero.classList.add('video-lecture'); }, { once: true });
      // La fin de la vidéo d'origine s'assombrit : on cristallise juste avant.
      video.addEventListener('timeupdate', function () {
        if (video.duration && video.duration - video.currentTime < 1.0) cristalliser();
      });
      video.addEventListener('ended', cristalliser);
      video.addEventListener('error', cristalliser);
      var p = video.play();
      if (p && p.catch) p.catch(cristalliser);
      setTimeout(function () { if (!hero.classList.contains('video-lecture')) cristalliser(); }, 3000);
      setTimeout(cristalliser, 9000);
    })();
  </script>
)}
