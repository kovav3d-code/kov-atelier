---
// Accueil, style « pixel technique » : titre en police pixel, lecture machine à droite, et en fond le buste de l'atelier
// reconstitué en points (14 000 points tirés du vrai modèle 3D), rendu en basse définition agrandie (pixels nets).
// À l'arrivée, le buste « s'imprime » couche par couche de bas en haut, une ligne bleue marque la couche en cours ;
// ensuite il tourne lentement et suit un peu la souris. Image fixe si l'utilisateur limite les animations.
// Les valeurs de la lecture machine sont décoratives (position de la buse, couche), pas des chiffres d'activité.
const INDEX = [
  { n: '01', titre: 'Conception', texte: 'Modèle 3D d’après vos cotes, plans ou photos', href: '/services' },
  { n: '02', titre: 'Impression', texte: 'Résine ou filament selon l’usage de la pièce', href: '/comment-ca-marche' },
  { n: '03', titre: 'Livraison', texte: 'La pièce chez vous, ou le fichier seul', href: '/devis' },
];
---
<section class="hx" aria-labelledby="hx-titre">
  <canvas class="hx-voxels" width="300" height="300" aria-hidden="true" data-points="/accueil/buste-points.bin"></canvas>
  <div class="wrap hx-grid">
    <div class="hx-texte">
      <p class="hx-sur"><span class="hx-led" aria-hidden="true"></span>Kov Atelier // Florange, Moselle</p>
      <h1 id="hx-titre">Conçu à la main, <span class="hx-souligne">imprimé couche après couche.</span></h1>
      <p class="hx-lead">Modélisation et impression 3D sur mesure, à côté du Luxembourg. Pièces cassées ou obsolètes, prototypes, pièces techniques et créations personnalisées, pour les professionnels comme pour les particuliers.</p>
      <div class="hx-actions">
        <a class="btn btn-primary" href="/devis" data-cta="hero">Demander un devis</a>
        <a class="hx-jeu" href="/atelier" data-cta="hero-jeu"><span aria-hidden="true">▸</span> Entrer dans l’atelier</a>
      </div>
      <p class="hx-note">Croquis, plan, photo, fichier 3D ou simple idée : tout point de départ convient.</p>
    </div>
    <dl class="hx-machine" aria-hidden="true">
      <div><dt>X</dt><dd data-axe="x">112.40</dd></div>
      <div><dt>Y</dt><dd data-axe="y">086.02</dd></div>
      <div><dt>Z</dt><dd data-axe="z">000.05</dd></div>
      <div><dt>Couche</dt><dd data-axe="couche">0000</dd></div>
      <div><dt>État</dt><dd data-axe="etat">Impression</dd></div>
    </dl>
  </div>
  <div class="wrap">
    <ol class="hx-index">
      {INDEX.map((e) => (
        <li><a href={e.href}><span class="hx-num">{e.n}</span><span class="hx-it">{e.titre}</span><span class="hx-ix">{e.texte}</span></a></li>
      ))}
    </ol>
  </div>
</section>
<script is:inline>
  (function () {
    var cv = document.querySelector('.hx-voxels');
    if (!cv) return;
    var cx = cv.getContext('2d'), W = cv.width, H = cv.height;
    var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var ax = {}; document.querySelectorAll('.hx-machine [data-axe]').forEach(function (d) { ax[d.dataset.axe] = d; });
    var P = null, n = 0, rot = 0.6, cible = 0, sx = 0, sy = 0, debut = 0, visible = true;
    var IMPRESSION = 4200, COUCHES = 1250;
    function pad(v, l) { v = String(v); while (v.length < l) v = '0' + v; return v; }
    fetch(cv.dataset.points).then(function (r) { return r.arrayBuffer(); }).then(function (b) {
      P = new Int16Array(b); n = P.length / 3;
      if (reduit) { dessiner(1, 0.6); ax.etat.textContent = 'Prête'; return; }
      requestAnimationFrame(boucle);
    });
    addEventListener('pointermove', function (e) { cible = (e.clientX / innerWidth - 0.5) * 0.8; sy = (e.clientY / innerHeight - 0.5) * 0.25; }, { passive: true });
    new IntersectionObserver(function (es) { visible = es[0].isIntersecting; if (visible && P && !reduit) requestAnimationFrame(boucle); }).observe(cv);
    var en = false;
    function boucle(t) {
      if (!visible) { en = false; return; }
      if (!debut) debut = t;
      var p = Math.min(1, (t - debut) / IMPRESSION);
      rot += 0.0026; sx += (cible - sx) * 0.05;
      dessiner(p, rot + sx);
      var k = Math.floor(p * COUCHES);
      ax.couche.textContent = pad(k, 4) + '/' + COUCHES;
      ax.z.textContent = pad((k * 0.05).toFixed(2), 6);
      ax.x.textContent = pad((112.4 + Math.sin(t / 310) * 38).toFixed(2), 6);
      ax.y.textContent = pad((86.02 + Math.cos(t / 270) * 31).toFixed(2), 6);
      if (p >= 1) ax.etat.textContent = 'Terminé';
      requestAnimationFrame(boucle);
    }
    function dessiner(p, a) {
      cx.clearRect(0, 0, W, H);
      var ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(sy), sb = Math.sin(sy);
      var lim = Math.floor(n * p), hCouche = -1 + 2 * p, s = W * 0.44;
      // Points triés de bas en haut : on ne dessine que ce qui est déjà imprimé.
      var img = cx.getImageData(0, 0, W, H), d = img.data, zb = new Float32Array(W * H).fill(-9);
      for (var i = 0; i < lim; i++) {
        var x = P[i * 3] / 32767, y = P[i * 3 + 1] / 32767, z = P[i * 3 + 2] / 32767;
        var X = x * ca + z * sa, Z = -x * sa + z * ca;
        var Y = y * cb - Z * sb; Z = y * sb + Z * cb;
        var px = Math.round(W / 2 + X * s), py = Math.round(H * 0.52 - Y * s);
        if (px < 0 || py < 0 || px >= W || py >= H) continue;
        var o = py * W + px; if (Z <= zb[o]) continue; zb[o] = Z;
        var l = 0.35 + 0.65 * (Z + 1) / 2, frais = (hCouche - y) < 0.035 && p < 1;
        var r = frais ? 143 : 217 * l + 38 * (1 - l), g = frais ? 176 : 195 * l + 34 * (1 - l), bl = frais ? 245 : 160 * l + 32 * (1 - l);
        o *= 4; d[o] = r; d[o + 1] = g; d[o + 2] = bl; d[o + 3] = 255;
      }
      cx.putImageData(img, 0, 0);
      if (p < 1) { cx.fillStyle = 'rgba(143,176,245,.55)'; cx.fillRect(W * 0.12, Math.round(H * 0.52 - hCouche * s), W * 0.76, 1); }
    }
  })();
</script>
