---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { r: CollectionEntry<'realisations'>; details?: boolean; tailles?: string; eager?: boolean; impression?: boolean }
const { r, details = false, tailles = '(max-width: 600px) 100vw, (max-width: 960px) 50vw, 400px', eager = false, impression = false } = Astro.props;
const d = r.data;
const n = d.photos.length + (d.video ? 1 : 0);
---
<li class="g-item" data-categories={d.categories.join('|')}>
  <figure>
    <div class:list={['g-frame', 'carrousel', { contain: d.ajustement === 'contain', 'fond-noir': !!d.video, imprime: impression }]} data-carrousel data-impression={impression ? '' : undefined} role={n > 1 ? 'region' : undefined} aria-roledescription={n > 1 ? 'carrousel' : undefined} aria-label={n > 1 ? `Photos : ${d.titre}` : undefined}>
      <div class="car-piste" tabindex={n > 1 ? 0 : undefined}>
        {d.video && (
          <div class="car-slide car-video" aria-label={n > 1 ? `1 sur ${n}` : undefined}>
            <video src={d.video.mp4} poster={d.video.poster} muted loop playsinline preload="metadata" aria-label={d.video.alt} data-auto></video>
          </div>
        )}
        {d.photos.map((p, i) => (
          <div class="car-slide" aria-label={n > 1 ? `${i + 1 + (d.video ? 1 : 0)} sur ${n}` : undefined}>
            <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]} sizes={tailles} loading={eager && i === 0 && !d.video ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      {n > 1 && (
        <>
          <button type="button" class="car-btn car-prec" aria-label="Photo précédente" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="car-btn car-suiv" aria-label="Photo suivante">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </>
      )}
      {impression && (
        <div class="tete-impression" aria-hidden="true"><span class="chariot"></span></div>
      )}
    </div>
    <figcaption>
      <span class="g-title">{d.titre}</span>
      <span class="g-meta">
        {d.categories.map((c) => <span>{c}</span>)}
        {d.nature === 'rendu' && <span class="g-nature">Rendu 3D</span>}
      </span>
      {details && (d.besoin || d.solution || d.technologie || d.typeProjet) && (
        <dl class="g-details">
          {d.typeProjet && <><dt>Type de projet</dt><dd>{d.typeProjet}</dd></>}
          {d.besoin && <><dt>Besoin initial</dt><dd>{d.besoin}</dd></>}
          {d.solution && <><dt>Solution apportée</dt><dd>{d.solution}</dd></>}
          {d.technologie && <><dt>Technologie</dt><dd>{d.technologie}</dd></>}
        </dl>
      )}
    </figcaption>
  </figure>
</li>

<script>
  // Vidéos en boucle : lecture seulement quand elles sont visibles (économise la batterie et les données).
  const lectureVisible = new IntersectionObserver((entrees) => {
    for (const e of entrees) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && e.intersectionRatio > 0.5) v.play().catch(() => {}); else v.pause();
    }
  }, { threshold: [0, 0.5, 1] });
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-auto]')) lectureVisible.observe(v);
  }

  // Carte « imprimée » : la tête d'impression remonte et révèle les photos couche par couche, une fois, quand la carte devient visible.
  const cadresImprimes = document.querySelectorAll<HTMLElement>('[data-impression]');
  if (cadresImprimes.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const declencheur = new IntersectionObserver((entrees) => {
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        const cadre = e.target as HTMLElement;
        declencheur.unobserve(cadre);
        cadre.classList.add('en-cours');
        cadre.addEventListener('animationend', (ev) => {
          if (ev.animationName === 'kov-revele') cadre.classList.remove('attente', 'en-cours');
        });
      }
    }, { threshold: 0.45 });
    for (const cadre of cadresImprimes) {
      const r = cadre.getBoundingClientRect();
      if (r.top < innerHeight * 0.55 && r.bottom > 0) continue; // déjà à l'écran au chargement : pas d'animation
      cadre.classList.add('attente');
      declencheur.observe(cadre);
    }
  }

  // Petit carrousel dans chaque carte : flèches, balayage tactile (défilement natif), flèches du clavier.
  for (const c of document.querySelectorAll<HTMLElement>('[data-carrousel]')) {
    const piste = c.querySelector<HTMLElement>('.car-piste');
    const prec = c.querySelector<HTMLButtonElement>('.car-prec');
    const suiv = c.querySelector<HTMLButtonElement>('.car-suiv');
    if (!piste || !prec || !suiv) continue;
    const n = piste.children.length;
    const courant = () => Math.round(piste.scrollLeft / Math.max(1, piste.clientWidth));
    const aller = (i: number) => piste.scrollTo({ left: Math.max(0, Math.min(n - 1, i)) * piste.clientWidth, behavior: 'smooth' });
    const maj = () => {
      const i = courant();
      prec.hidden = i <= 0;
      suiv.hidden = i >= n - 1;
    };
    prec.addEventListener('click', () => aller(courant() - 1));
    suiv.addEventListener('click', () => aller(courant() + 1));
    piste.addEventListener('scroll', () => requestAnimationFrame(maj), { passive: true });
    piste.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); aller(courant() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); aller(courant() - 1); }
    });
    window.addEventListener('resize', maj);
  }
</script>
