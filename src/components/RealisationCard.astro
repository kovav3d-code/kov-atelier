---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { r: CollectionEntry<'realisations'>; details?: boolean; tailles?: string; eager?: boolean }
const { r, details = false, tailles = '(max-width: 600px) 100vw, (max-width: 960px) 50vw, 400px', eager = false } = Astro.props;
const d = r.data;
const n = d.photos.length;
---
<li class="g-item" data-categories={d.categories.join('|')}>
  <figure>
    <div class:list={['g-frame', 'carrousel', { contain: d.ajustement === 'contain' }]} data-carrousel role={n > 1 ? 'region' : undefined} aria-roledescription={n > 1 ? 'carrousel' : undefined} aria-label={n > 1 ? `Photos : ${d.titre}` : undefined}>
      <div class="car-piste" tabindex={n > 1 ? 0 : undefined}>
        {d.photos.map((p, i) => (
          <div class="car-slide" aria-label={n > 1 ? `${i + 1} sur ${n}` : undefined}>
            <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]} sizes={tailles} loading={eager && i === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      {n > 1 && (
        <>
          <button type="button" class="car-btn car-prec" aria-label="Photo précédente" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="car-btn car-suiv" aria-label="Photo suivante">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
          <span class="g-count" aria-hidden="true"><span class="car-idx">1</span> / {n}</span>
        </>
      )}
    </div>
    <figcaption>
      <span class="g-title">{d.titre}</span>
      <span class="g-meta">
        {d.categories.map((c) => <span>{c}</span>)}
        {d.nature === 'rendu' && <span class="g-nature">Rendu 3D</span>}
      </span>
      {details && (d.besoin || d.solution || d.technologie || d.typeProjet) && (
        <dl class="g-details">
          {d.typeProjet && <><dt>Type de projet</dt><dd>{d.typeProjet}</dd></>}
          {d.besoin && <><dt>Besoin initial</dt><dd>{d.besoin}</dd></>}
          {d.solution && <><dt>Solution apportée</dt><dd>{d.solution}</dd></>}
          {d.technologie && <><dt>Technologie</dt><dd>{d.technologie}</dd></>}
        </dl>
      )}
    </figcaption>
  </figure>
</li>

<script>
  // Petit carrousel dans chaque carte : flèches, balayage tactile (défilement natif), flèches du clavier.
  for (const c of document.querySelectorAll<HTMLElement>('[data-carrousel]')) {
    const piste = c.querySelector<HTMLElement>('.car-piste');
    const prec = c.querySelector<HTMLButtonElement>('.car-prec');
    const suiv = c.querySelector<HTMLButtonElement>('.car-suiv');
    const idx = c.querySelector<HTMLElement>('.car-idx');
    if (!piste || !prec || !suiv || !idx) continue;
    const n = piste.children.length;
    const courant = () => Math.round(piste.scrollLeft / Math.max(1, piste.clientWidth));
    const aller = (i: number) => piste.scrollTo({ left: Math.max(0, Math.min(n - 1, i)) * piste.clientWidth, behavior: 'smooth' });
    const maj = () => {
      const i = courant();
      idx.textContent = String(i + 1);
      prec.hidden = i <= 0;
      suiv.hidden = i >= n - 1;
    };
    prec.addEventListener('click', () => aller(courant() - 1));
    suiv.addEventListener('click', () => aller(courant() + 1));
    piste.addEventListener('scroll', () => requestAnimationFrame(maj), { passive: true });
    piste.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); aller(courant() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); aller(courant() - 1); }
    });
    window.addEventListener('resize', maj);
  }
</script>
