---
// Animation en boucle : un artisan forge une lame sur l'enclume (SVG + CSS, sans bibliothèque).
// Le marteau monte puis frappe, la lame rougeoie à chaque coup et des étincelles jaillissent.
// Image fixe si l'utilisateur limite les animations.
---
<figure class="forge" aria-hidden="true">
  <svg viewBox="0 0 520 240" class="forge-svg">
    <defs>
      <linearGradient id="forge-lame" x1="0" x2="1">
        <stop offset="0" stop-color="#5b6570" />
        <stop offset=".35" stop-color="#ff8a3d" />
        <stop offset=".7" stop-color="#ffd27a" />
        <stop offset="1" stop-color="#ff6a2b" />
      </linearGradient>
      <radialGradient id="forge-halo">
        <stop offset="0" stop-color="#ff9a4d" stop-opacity=".55" />
        <stop offset="1" stop-color="#ff9a4d" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="forge-foyer">
        <stop offset="0" stop-color="#ff7a2e" stop-opacity=".9" />
        <stop offset=".6" stop-color="#c2410c" stop-opacity=".35" />
        <stop offset="1" stop-color="#c2410c" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Sol -->
    <line x1="20" y1="214" x2="500" y2="214" class="forge-sol" />

    <!-- Foyer au fond, qui respire -->
    <g class="forge-four">
      <rect x="400" y="120" width="86" height="94" rx="6" class="forge-metal" />
      <rect x="414" y="140" width="58" height="40" rx="20" class="forge-bouche" />
      <ellipse cx="443" cy="166" rx="34" ry="22" fill="url(#forge-foyer)" class="forge-braise" />
      <rect x="430" y="70" width="26" height="52" class="forge-metal" />
    </g>

    <!-- Enclume -->
    <g class="forge-enclume">
      <path d="M212 150h128c0 0-4 10-22 12l-10 2v16h18l6 34h-112l6-34h18v-16l-10-2c-12-2-22-6-22-12z" class="forge-metal" />
      <path d="M212 150c-18 0-34-4-40-10h40z" class="forge-metal" />
    </g>

    <!-- Lame posée sur l'enclume -->
    <ellipse cx="282" cy="146" rx="70" ry="14" fill="url(#forge-halo)" class="forge-halo" />
    <g class="forge-epee">
      <path d="M226 144h108l14 3-14 3h-108z" fill="url(#forge-lame)" class="forge-lame" />
      <rect x="206" y="141" width="20" height="12" rx="2" class="forge-garde" />
      <rect x="186" y="144.5" width="22" height="5" rx="2" class="forge-poignee" />
    </g>

    <!-- Artisan -->
    <g class="forge-artisan">
      <path d="M118 214l6-62h30l6 62" class="forge-corps" />
      <path d="M112 152c0-26 10-46 28-46s28 20 28 46z" class="forge-corps" />
      <path d="M124 120h32v70h-32z" class="forge-tablier" />
      <circle cx="140" cy="88" r="15" class="forge-corps" />
      <path d="M126 84c4-10 24-12 30-2" class="forge-cheveux" />
      <!-- Bras arrière, tenant la pince -->
      <path d="M150 126l46 14 12 4" class="forge-bras" />
      <path d="M206 142l20 4" class="forge-pince" />
      <!-- Bras avant + marteau, qui pivote à l'épaule -->
      <g class="forge-frappe">
        <path d="M150 118l44 2" class="forge-bras" />
        <rect x="190" y="116" width="44" height="6" rx="3" class="forge-manche" />
        <rect x="226" y="104" width="18" height="30" rx="3" class="forge-tete" />
      </g>
    </g>

    <!-- Étincelles au point d'impact -->
    <g class="forge-etincelles">
      <circle cx="236" cy="142" r="2.2" style="--dx:-38px;--dy:-46px" />
      <circle cx="236" cy="142" r="1.8" style="--dx:-14px;--dy:-62px" />
      <circle cx="236" cy="142" r="2" style="--dx:18px;--dy:-58px" />
      <circle cx="236" cy="142" r="1.6" style="--dx:44px;--dy:-40px" />
      <circle cx="236" cy="142" r="1.4" style="--dx:60px;--dy:-18px" />
      <circle cx="236" cy="142" r="1.6" style="--dx:-56px;--dy:-20px" />
      <circle cx="236" cy="142" r="1.2" style="--dx:30px;--dy:-74px" />
    </g>
  </svg>
</figure>
