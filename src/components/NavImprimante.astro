---
// Navigation « imprimante » (grands écrans) : le plateau monte ou descend vers le niveau de la section
// où se trouve le visiteur (Accueil, Réalisations, Devis). Pendant qu'on fait défiler la page,
// une petite pièce s'imprime couche par couche sur le plateau. Cliquer sur un niveau y emmène.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const NIVEAUX = [
  { id: 'accueil', label: 'Accueil', href: '/' },
  { id: 'realisations', label: 'Réalisations', href: '/realisations' },
  { id: 'devis', label: 'Devis', href: '/devis' },
];
const courant = path.startsWith('/realisations') ? 1 : path.startsWith('/devis') ? 2 : 0;
---
<nav class="nav-imp" aria-label="Navigation rapide" data-nav-imp data-page={path} data-niveau={courant}>
  <svg class="nav-imp-cadre" viewBox="0 0 64 300" aria-hidden="true">
    <rect x="6" y="6" width="5" height="282" rx="2" />
    <rect x="53" y="6" width="5" height="282" rx="2" />
    <rect x="4" y="2" width="56" height="7" rx="2" />
    <rect x="2" y="286" width="60" height="10" rx="3" />
    <circle class="nav-imp-led" cx="10" cy="291" r="1.8" />
  </svg>
  <div class="nav-imp-plateau" aria-hidden="true">
    <svg class="nav-imp-piece" viewBox="0 0 40 40">
      <defs><clipPath id="nav-imp-clip"><rect class="nav-imp-niveau" x="0" y="40" width="40" height="0" /></clipPath></defs>
      <g clip-path="url(#nav-imp-clip)">
        <path d="M14 39h12v-3h4c1-4-1-8-5-10 3-2 4-5 4-8 0-6-4-10-9-10s-9 4-9 10c0 3 1 6 4 8-4 2-6 6-5 10h4z" />
        <path class="nav-imp-couches" d="M8 33h24M8 30h24M10 27h20" />
      </g>
    </svg>
    <span class="nav-imp-barre"></span>
  </div>
  <ol class="nav-imp-niveaux">
    {NIVEAUX.map((n, i) => (
      <li style={`--y:${i}`}>
        <a href={n.href} data-niveau={i} aria-current={i === courant ? 'page' : undefined}>
          <span class="nav-imp-cran" aria-hidden="true"></span>{n.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
<script is:inline>
  (function () {
    var nav = document.querySelector('[data-nav-imp]');
    if (!nav) return;
    var plateau = nav.querySelector('.nav-imp-plateau');
    var niveau = nav.querySelector('.nav-imp-niveau');
    var liens = nav.querySelectorAll('a[data-niveau]');
    var page = nav.dataset.page;
    var base = +nav.dataset.niveau;
    // Hauteurs des trois niveaux (en % du rail), du haut vers le bas.
    var Y = [6, 46, 86];
    function poser(i, frac) {
      var y = frac == null ? Y[i] : frac;
      plateau.style.top = y + '%';
      liens.forEach(function (a, k) { a.classList.toggle('actif', k === i); });
    }
    // Sur l'accueil, le plateau suit le défilement : haut de page → Accueil, réalisations → Réalisations, fin → Devis.
    function surAccueil() {
      var real = document.getElementById('realisations');
      var fin = document.querySelector('.cta-final');
      var yR = real ? real.getBoundingClientRect().top + scrollY - innerHeight * 0.4 : 1;
      var yD = fin ? fin.getBoundingClientRect().top + scrollY - innerHeight * 0.6 : document.body.scrollHeight;
      var s = scrollY, f, i;
      if (s <= yR) { f = Y[0] + (Y[1] - Y[0]) * Math.max(0, s / Math.max(1, yR)); i = s / yR > 0.6 ? 1 : 0; }
      else { var t = Math.min(1, (s - yR) / Math.max(1, yD - yR)); f = Y[1] + (Y[2] - Y[1]) * t; i = t > 0.6 ? 2 : 1; }
      poser(i, f);
    }
    // La pièce sur le plateau s'imprime avec la progression dans la page.
    function imprimer() {
      var max = document.documentElement.scrollHeight - innerHeight;
      var p = max > 0 ? Math.min(1, scrollY / max) : 1;
      var h = 6 + 34 * p;
      niveau.setAttribute('y', String(40 - h));
      niveau.setAttribute('height', String(h));
    }
    var prevu = false;
    function maj() { prevu = false; if (page === '/') surAccueil(); else poser(base); imprimer(); }
    addEventListener('scroll', function () { if (!prevu) { prevu = true; requestAnimationFrame(maj); } }, { passive: true });
    addEventListener('resize', maj);
    maj();
    // Au clic : le plateau part vers le niveau choisi, puis on y va.
    liens.forEach(function (a) {
      a.addEventListener('click', function (e) {
        var i = +a.dataset.niveau;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (page === '/' && i === 0) { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); return; }
        if (page === '/' && i === 1) { e.preventDefault(); var r = document.getElementById('realisations'); if (r) r.scrollIntoView({ behavior: 'smooth' }); return; }
        e.preventDefault();
        nav.classList.add('en-route');
        poser(i);
        setTimeout(function () { location.href = a.getAttribute('href'); }, 520);
      });
    });
  })();
</script>
