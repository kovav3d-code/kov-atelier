---
// Section « façon Apple » : dès que la section arrive à l'écran, la sculpture (Cthulhu en 5 pièces) passe toute seule
// de l'éclaté à l'assemblé, fait un tour complet puis la caméra s'approche de la tête, et s'arrête sur la dernière image.
// Aucun défilement nécessaire. Images pré-calculées (rendus 3D de l'atelier, pas d'IA) dessinées dans un canvas.
// Quatre textes se relaient à côté ; bouton « Revoir » à la fin. Se met en pause si la section sort de l'écran.
// Sans images dans public/defile/cthulhu, la section n'apparaît pas. Animations réduites : image fixe + textes à la suite.
import fs from 'node:fs';
import path from 'node:path';
const DOSSIER = '/defile/cthulhu/';
const N = 120;
const actif = fs.existsSync(path.join(process.cwd(), 'public', DOSSIER, 'c000.webp'));
const ETAPES = [
  { de: 0, a: 0.2, sur: 'Sculpture en cinq pièces', titre: 'Pensée pièce par pièce', texte: 'Tête, corps, ailes, logo, socle : chaque élément est modélisé pour s’imprimer seul, puis s’emboîter.' },
  { de: 0.24, a: 0.44, sur: 'Assemblage', titre: 'Puis réunie', texte: 'Les pièces se rejoignent pour former la sculpture finale.' },
  { de: 0.5, a: 0.8, sur: 'À 360°', titre: 'Travaillée sous tous les angles', texte: 'Ailes, tentacules, gravures du socle : chaque face est sculptée, pas seulement celle de la photo.' },
  { de: 0.86, a: 1.01, sur: 'Votre projet', titre: 'Jusqu’au moindre détail', texte: 'Une figurine, un buste, une pièce de collection : on la conçoit avec vous.', cta: true },
];
---
{actif && (
  <section class="sdf" aria-label="La sculpture Cthulhu, de ses cinq pièces à la sculpture assemblée" data-defile data-dossier={DOSSIER} data-n={N}>
    <div class="sdf-scene">
      <canvas class="sdf-canvas" width="1000" height="1000" aria-hidden="true"></canvas>
      <img class="sdf-fixe" src={`${DOSSIER}c085.webp`} alt="La sculpture Cthulhu assemblée sur son socle gravé, rendu 3D" width="1000" height="1000" loading="lazy" decoding="async" />
      <div class="sdf-textes">
        {ETAPES.map((e) => (
          <div class="sdf-etape" data-de={e.de} data-a={e.a}>
            <p class="sdf-sur">{e.sur}</p>
            <h2>{e.titre}</h2>
            <p>{e.texte}</p>
            {e.cta && <a class="btn btn-primary" href="/devis?prestation=artistique" data-cta="defile">Demander un devis</a>}
          </div>
        ))}
      </div>
      <button type="button" class="sdf-revoir" hidden>↻ Revoir l’animation</button>
      <div class="sdf-barre" aria-hidden="true"><span></span></div>
    </div>
  </section>
)}
<script is:inline>
  (function () {
    var s = document.querySelector('[data-defile]');
    if (!s) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { s.classList.add('sdf-reduit'); return; }
    var cv = s.querySelector('canvas'), cx = cv.getContext('2d'), N = +s.dataset.n, dos = s.dataset.dossier;
    var etapes = [].slice.call(s.querySelectorAll('.sdf-etape')), barre = s.querySelector('.sdf-barre span'), revoir = s.querySelector('.sdf-revoir');
    var DUREE = 9000;                                  // durée totale de l'animation (ms)
    var imgs = new Array(N), nbCharges = 0, charge = false, dernier = -1;
    var p = 0, joue = false, visible = false, fini = false, t0 = 0;
    function nom(i) { return dos + 'c' + ('00' + i).slice(-3) + '.webp'; }
    function img(i, cb) { var im = new Image(); im.decoding = 'async'; im.onload = function () { imgs[i] = im; nbCharges++; if (cb) cb(); }; im.onerror = function () { nbCharges++; if (cb) cb(); }; im.src = nom(i); }
    img(0, function () { dessiner(true); });
    function charger() {
      if (charge) return; charge = true;
      var k = 1; (function suite() { var lot = []; while (lot.length < 8 && k < N) lot.push(k++); var r = lot.length; if (!r) return;
        lot.forEach(function (j) { img(j, function () { if (--r === 0) suite(); peutDemarrer(); }); }); })();
    }
    function proche(i) { for (var d = 0; d < N; d++) { if (imgs[i - d]) return imgs[i - d]; if (imgs[i + d]) return imgs[i + d]; } return null; }
    function dessiner(force) {
      var i = Math.round(p * (N - 1));
      if (i !== dernier || force) { var im = proche(i); if (im) { cx.drawImage(im, 0, 0, cv.width, cv.height); dernier = imgs[i] ? i : -1; } }
      etapes.forEach(function (e) { e.classList.toggle('visible', p >= +e.dataset.de && p < +e.dataset.a); });
      barre.style.transform = 'scaleX(' + p.toFixed(4) + ')';
    }
    function boucle(t) {
      if (!joue) return;
      if (!t0) t0 = t - p * DUREE;
      p = Math.min(1, (t - t0) / DUREE);
      dessiner(false);
      if (p >= 1) { joue = false; fini = true; revoir.hidden = false; return; }
      requestAnimationFrame(boucle);
    }
    function lancer() { if (joue || fini) return; joue = true; t0 = 0; requestAnimationFrame(boucle); }
    // Démarre quand la section est bien visible et que toutes les images sont prêtes.
    function peutDemarrer() { if (visible && nbCharges >= N - 1) lancer(); }
    new IntersectionObserver(function (es) { if (es[0].isIntersecting) charger(); }, { rootMargin: '150% 0px' }).observe(s);
    new IntersectionObserver(function (es) {
      visible = es[0].intersectionRatio >= 0.55;
      if (visible) peutDemarrer(); else if (joue) joue = false;   // pause hors écran, reprise au retour
    }, { threshold: [0, 0.55, 1] }).observe(s);
    revoir.addEventListener('click', function () { revoir.hidden = true; fini = false; p = 0; dessiner(true); lancer(); });
    addEventListener('resize', function () { dessiner(true); });
  })();
</script>
