---
// Animation en boucle : sculpture murale de deux carpes koï autour d'un anneau lumineux,
// aux couleurs du site (anthracite, métal, bleu). CSS + filtre SVG, sans bibliothèque.
// L'eau ondule autour des koï, l'anneau et les suspensions pulsent, un reflet balaie le métal.
// Les deux liens de la page sont des lumières sans texte, logées au cœur des deux anneaux suspendus :
// l'objectif photo (anneau de droite) mène aux photos et vidéos, le cube 3D (anneau du bas) aux modèles 3D.
// Image fixe si l'utilisateur limite les animations.
import { Image } from 'astro:assets';
import koi from '../assets/realisations/koi-anneau.jpg';
const particules = Array.from({ length: 14 }, (_, i) => ({ l: 10 + ((i * 11) % 80), d: ((i * 1.7) % 9).toFixed(1), s: 2 + (i % 3) }));
---
<figure class="koi">
  <div class="koi-flotte" aria-hidden="true">
    <Image src={koi} alt="" widths={[380, 600, 800]} sizes="(max-width: 760px) 78vw, 400px" class="koi-img" loading="eager" />
    <div class="koi-eau"><Image src={koi} alt="" widths={[380, 600, 800]} sizes="(max-width: 760px) 78vw, 400px" class="koi-img" loading="eager" /></div>
    <span class="koi-anneau"></span>
    <span class="koi-reflet"></span>
    <span class="koi-poussiere">
      {particules.map((p) => <i style={`--l:${p.l}%;--d:${p.d}s;--s:${p.s}px`}></i>)}
    </span>
  </div>
  <nav class="koi-liens" aria-label="Sections de la page">
    <!-- Anneau suspendu de droite → photos et vidéos : un objectif d'appareil dont le diaphragme s'ouvre et se ferme, avec un flash discret. -->
    <a class="koi-lien koi-lien--geode" href="#en-vrai" aria-label="Photos et vidéos de l’atelier">
      <span class="koi-halo" aria-hidden="true"></span>
      <svg class="koi-icone koi-objectif" viewBox="0 0 48 48" aria-hidden="true">
        <path class="koi-boitier" d="M8 16.5h7.5l3-4.5h11l3 4.5H40a3 3 0 0 1 3 3V36a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V19.5a3 3 0 0 1 3-3z" />
        <circle class="koi-bague" cx="24" cy="27.5" r="8.5" />
        <g class="koi-diaphragme">
          <path d="M24 21.5l3.2 5.6M29.2 25.5l-3.2 5.6M27.2 32.6h-6.4M18.8 29.5l3.2-5.6M18.8 25.5l3.2 5.6M20.8 22.4h6.4" />
        </g>
        <circle class="koi-flash" cx="36.5" cy="21.5" r="1.6" />
      </svg>
    </a>
    <!-- Anneau suspendu du bas → modèles 3D : un cube en fil de fer qui tourne sur lui-même. -->
    <a class="koi-lien koi-lien--console" href="#modeles-3d" aria-label="Modèles 3D">
      <span class="koi-halo" aria-hidden="true"></span>
      <span class="koi-cube" aria-hidden="true">
        <i class="f1"></i><i class="f2"></i><i class="f3"></i><i class="f4"></i><i class="f5"></i><i class="f6"></i>
      </span>
    </a>
  </nav>
  <svg width="0" height="0" class="koi-defs" aria-hidden="true">
    <filter id="koi-ondule">
      <feTurbulence type="fractalNoise" baseFrequency="0.010 0.028" numOctaves="2" seed="4">
        <animate attributeName="baseFrequency" dur="10s" values="0.010 0.028;0.014 0.034;0.010 0.028" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="7" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</figure>
