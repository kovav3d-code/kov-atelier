---
// Animation en boucle : sculpture murale de deux carpes koï autour d'un anneau lumineux,
// aux couleurs du site (anthracite, métal, bleu). CSS + filtre SVG, sans bibliothèque.
// L'eau ondule autour des koï, l'anneau et les suspensions pulsent, un reflet balaie le métal.
// Image fixe si l'utilisateur limite les animations.
import { Image } from 'astro:assets';
import koi from '../assets/realisations/koi-anneau.jpg';
const particules = Array.from({ length: 14 }, (_, i) => ({ l: 10 + ((i * 11) % 80), d: ((i * 1.7) % 9).toFixed(1), s: 2 + (i % 3) }));
---
<figure class="koi" aria-hidden="true">
  <div class="koi-flotte">
    <Image src={koi} alt="" widths={[360, 720]} sizes="(max-width: 400px) 90vw, 360px" class="koi-img" loading="eager" />
    <div class="koi-eau"><Image src={koi} alt="" widths={[360, 720]} sizes="(max-width: 400px) 90vw, 360px" class="koi-img" loading="eager" /></div>
    <span class="koi-anneau"></span>
    <span class="koi-lampe" style="left:47.7%;top:95.5%"></span>
    <span class="koi-lampe" style="left:61.9%;top:84.7%;animation-delay:1.3s"></span>
    <span class="koi-lampe" style="left:70.2%;top:93.6%;animation-delay:2.4s"></span>
    <span class="koi-reflet"></span>
    <span class="koi-poussiere">
      {particules.map((p) => <i style={`--l:${p.l}%;--d:${p.d}s;--s:${p.s}px`}></i>)}
    </span>
  </div>
  <svg width="0" height="0" class="koi-defs">
    <filter id="koi-ondule">
      <feTurbulence type="fractalNoise" baseFrequency="0.010 0.028" numOctaves="2" seed="4">
        <animate attributeName="baseFrequency" dur="10s" values="0.010 0.028;0.014 0.034;0.010 0.028" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="7" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</figure>
