---
// Hero de l'accueil : carte sombre, grand titre sur deux lignes (fine puis grasse), le masque sculpté de l'atelier
// à gauche et un texte court + devis à droite. Sous la fumée, une deuxième structure : « Ce que fait l'atelier »
// avec, à gauche, une séquence vidéo (générée avec Higgsfield) où le masque se pose sur un buste en verre aux
// veines bleues.
// Au défilement : le masque du hero tournoie et glisse vers le coin haut gauche de la vidéo, puis s'efface pendant que
// la vidéo apparaît (relais entre les deux masques) ; la vidéo avance ensuite avec le défilement jusqu'au masque posé.
// Poids : images en deux tailles (ordinateur / téléphone), seule la première se charge à l'ouverture.
// Animations réduites : dernière image de la vidéo, sans mouvement.
import fs from 'node:fs';
import path from 'node:path';
const DOSSIER = '/accueil/pose-v2/';      // masque qui tournoie (changer le nom du dossier à chaque nouvelle version)
const N = 72;
const VIDEO = '/accueil/buste-ia/';      // séquence vidéo du buste
const NV = 61;
// Volutes de fumée : [gauche %, haut %, taille relative]
const FUMEE = [[-12, 30, 1.1], [2, 52, .8], [10, 18, 1.4], [22, 44, .9], [30, 24, 1.2], [40, 55, .75], [48, 30, 1.35], [58, 46, .9], [64, 16, 1.1], [72, 50, 1.25], [80, 28, .85], [88, 46, 1.3], [94, 20, .9], [-4, 62, 1]];
const actif = fs.existsSync(path.join(process.cwd(), 'public', DOSSIER, 'grand', 'm000.webp')) && fs.existsSync(path.join(process.cwd(), 'public', VIDEO, 'grand', 'v000.webp'));
---
<section class="hm" aria-labelledby="hm-titre">
  <div class="hm-carte">
    <h1 id="hm-titre" class="hm-titre"><span class="hm-fin">Conçu à la main,</span> <span class="hm-gras">imprimé couche après couche</span></h1>
    <div class="hm-bas">
      <div class="hm-objet" aria-hidden="true">
        {actif && <canvas class="hm-canvas" data-dossier={DOSSIER} data-n={N}></canvas>}
      </div>
      <div class="hm-texte">
        <p><strong>Kov Atelier</strong> modélise et imprime vos pièces sur mesure, du prototype à la pièce unique, à Florange.</p>
        <a class="btn btn-primary" href="/devis" data-cta="hero">Demander un devis <span aria-hidden="true">›</span></a>
        <a class="hm-lien" href="#realisations">Ou voir nos réalisations</a>
      </div>
    </div>
  </div>
  <div class="hm-fumee" aria-hidden="true">{FUMEE.map((f, i) => <span style={`--i:${i};left:${f[0]}%;top:${f[1]}%;--t:${f[2]}`}></span>)}</div>
  <!-- Deuxième structure : la séquence vidéo à gauche, le texte à droite -->
  <div class="hm-suite">
    <div class="hm-place" aria-hidden="true">
      <span class="hm-brume">{[0, 1, 2, 3, 4, 5].map((i) => <span style={`--i:${i}`}></span>)}</span>
      {actif && (
        <>
          <canvas class="hm-video" width="660" height="880" data-dossier={VIDEO} data-n={NV}></canvas>
          <picture class="hm-video-fixe">
            <source media="(max-width: 799px)" srcset={`${VIDEO}petit/v060.webp`} />
            <img src={`${VIDEO}grand/v060.webp`} alt="" decoding="async" loading="lazy" />
          </picture>
        </>
      )}
    </div>
    <div class="hm-suite-texte">
      <p class="hm-sur">Ce que fait l’atelier</p>
      <h2 class="hm-titre2"><span class="hm-fin">Modélisation, impression</span> <span class="hm-gras">et rétro-ingénierie</span></h2>
      <p>D’une photo, d’un plan ou d’une pièce cassée, l’atelier conçoit le modèle 3D puis l’imprime en résine ou en filament, selon l’usage.</p>
      <a class="hm-lien" href="/services">Voir les services <span aria-hidden="true">›</span></a>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var cv = document.querySelector('.hm-canvas'), vc = document.querySelector('.hm-video');
    if (!cv || !vc) return;
    var hero = cv.closest('.hm'), objet = cv.parentElement, place = hero.querySelector('.hm-place');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { hero.classList.add('hm-reduit'); return; }
    var taille = innerWidth < 800 ? 'petit/' : 'grand/';
    // Deux séquences : le masque qui tournoie (hero) et la vidéo du buste
    function sequence(canvas, dossier, prefixe, n) {
      var q = { cv: canvas, cx: canvas.getContext('2d'), n: n, imgs: new Array(n), dernier: -1, dos: dossier + taille, pre: prefixe };
      q.nom = function (i) { return q.dos + q.pre + ('00' + i).slice(-3) + '.webp'; };
      q.charger = function (i, cb) { var im = new Image(); im.decoding = 'async'; im.onload = function () { q.imgs[i] = im; if (cb) cb(); }; im.src = q.nom(i); };
      q.proche = function (i) { for (var d = 0; d < n; d++) { if (q.imgs[i - d]) return q.imgs[i - d]; if (q.imgs[i + d]) return q.imgs[i + d]; } return null; };
      q.dessiner = function (i, force) {
        if (i === q.dernier && !force) return;
        var im = q.proche(i); if (!im) return;
        if (q.cv.width !== im.naturalWidth) { q.cv.width = im.naturalWidth; q.cv.height = im.naturalHeight; }
        q.cx.clearRect(0, 0, q.cv.width, q.cv.height); q.cx.drawImage(im, 0, 0); q.dernier = q.imgs[i] ? i : -1;
      };
      q.lereste = function () {
        var ordre = []; for (var i = 1; i < n; i += 3) ordre.push(i); for (i = 1; i < n; i++) if ((i - 1) % 3) ordre.push(i);
        var k = 0; (function suite() { var lot = ordre.slice(k, k + 6); k += 6; var r = lot.length; if (!r) return;
          lot.forEach(function (j) { q.charger(j, function () { if (--r === 0) setTimeout(suite, 30); maj(true); }); }); })();
      };
      return q;
    }
    var M = sequence(cv, cv.dataset.dossier, 'm', 41);        // seulement la partie « tournoie » (avant l'atterrissage)
    var V = sequence(vc, vc.dataset.dossier, 'v', +vc.dataset.n);
    M.charger(0, function () { M.dessiner(0, true); mesurer(); maj(true); hero.classList.add('hm-pret'); });
    V.charger(0, function () { mesurer(); maj(true); });
    function lereste() { M.lereste(); setTimeout(V.lereste, 300); }
    if (document.readyState === 'complete') setTimeout(lereste, 200); else addEventListener('load', function () { setTimeout(lereste, 200); });

    // Le masque du hero vise le coin haut gauche de la vidéo, là où se trouve le masque au début de la séquence.
    var FIN = 1;
    // Position du masque dans chaque séquence (mesurée sur les images) : centre et largeur relatifs au cadre.
    var MH = { x: 0.26, y: 0.228, l: 0.407 }, MV = { x: 0.26, y: 0.165, l: 0.43 };
    function mesurer() {
      objet.style.setProperty('--p', '0');
      var ob = objet.getBoundingClientRect(), o = cv.getBoundingClientRect(), t = place.getBoundingClientRect();
      // point d'ancrage : le centre du masque dans le canvas du hero
      var ax = o.left - ob.left + o.width * MH.x, ay = o.top - ob.top + o.height * MH.y;
      objet.style.transformOrigin = ax + 'px ' + ay + 'px';
      // il doit rejoindre le centre du masque de la vidéo, à la même taille
      var cx = t.left + t.width * MV.x, cy = t.top + t.height * MV.y;
      objet.style.setProperty('--dx', Math.round(cx - (ob.left + ax)) + 'px');
      objet.style.setProperty('--d', Math.round(cy - (ob.top + ay)) + 'px');
      objet.style.setProperty('--s', ((t.width * MV.l) / Math.max(1, o.width * MH.l)).toFixed(3));
      FIN = Math.max(1, t.top + scrollY + t.height / 2 - innerHeight / 2);
    }
    function lis(x) { return x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x); }
    function maj(force) {
      var P = Math.max(0, Math.min(1, scrollY / FIN));
      // 0 → 0,5 : le masque du hero voyage ; 0,38 → 0,52 : relais (il s'efface, la vidéo apparaît) ; 0,45 → 1 : la vidéo avance
      var pm = Math.min(1, P / 0.5);
      M.dessiner(Math.round(pm * (M.n - 1)), force);
      objet.style.setProperty('--p', pm.toFixed(4));
      var relais = lis((P - 0.38) / 0.14);
      objet.style.opacity = (1 - relais).toFixed(3);
      vc.style.opacity = relais.toFixed(3);
      V.dessiner(Math.round(lis((P - 0.45) / 0.55) * (V.n - 1)), force);
    }
    mesurer(); addEventListener('resize', function () { mesurer(); maj(true); }); addEventListener('load', function () { mesurer(); maj(true); });
    var attente = false;
    addEventListener('scroll', function () { if (attente) return; attente = true; requestAnimationFrame(function () { attente = false; maj(false); }); }, { passive: true });
  })();
</script>
