---
// Hero de l'accueil : carte sombre, grand titre sur deux lignes (fine puis grasse), le masque sculpté de l'atelier
// et un texte court + devis. Sous la fumée, une deuxième structure : « Ce que fait l'atelier » avec, à gauche, une tête
// encapuchonnée (rendu 3D) sur laquelle le masque vient se poser.
// Animation « premium » (brief validé par Valéry) : une scène fixe et sombre au milieu de l'écran où la tête et le masque
// restent ensemble. Au défilement (environ 4 hauteurs d'écran) : gros plan du masque qui tourne lentement, recul de la
// caméra à travers la fumée pendant que la tête apparaît, descente à droite de la tête et boucle lente, approche en arc
// jusqu'en face du visage, temps d'arrêt, pose en deux temps, puis un reflet de lumière balaie le masque. La scène se
// décolle exactement sur la place de la tête et la page reprend.
// Fluidité : la scène est collante (position: sticky, gérée par le navigateur) ; la progression suit le doigt avec un
// léger amorti ; 180 images avec fondu entre deux images voisines ; images décodées en arrière-plan autour de la
// position courante (createImageBitmap) ; chaque image n'est que la vignette utile (vignettes.json donne sa place).
// Animations réduites : la tête masquée, sans mouvement. Position du masque : réglée par Valéry dans Nomad.
import fs from 'node:fs';
import path from 'node:path';
const DOSSIER = '/accueil/pose-v6/';      // changer le nom du dossier à chaque nouvelle version (cache des navigateurs)
const N = 180;
// Deux séquences : « grand » (ordinateur, tablette) et « petit » (téléphone, trajet plus serré pour rester dans l'écran).
// Pour chacune : taille de la tête, place de la tête dans le cadre du masque (gauche, haut, largeur, hauteur en fractions)
// et centre du masque sur la 1re image.
const G = { tete: [800, 994], cadre: [0, 0.0945, 0.548, 0.8725], m0: [0.3134, 0.4741] };
const P = { tete: [540, 669], cadre: [0, 0.0962, 0.8003, 0.9038], m0: [0.457, 0.4919] };
const [L, H] = G.tete;
// Volutes de fumée : [gauche %, haut %, taille relative]
const FUMEE = [[-12, 30, 1.1], [2, 52, .8], [10, 18, 1.4], [22, 44, .9], [30, 24, 1.2], [40, 55, .75], [48, 30, 1.35], [58, 46, .9], [64, 16, 1.1], [72, 50, 1.25], [80, 28, .85], [88, 46, 1.3], [94, 20, .9], [-4, 62, 1]];
const actif = fs.existsSync(path.join(process.cwd(), 'public', DOSSIER, 'grand', 'm000.webp')) && fs.existsSync(path.join(process.cwd(), 'public', DOSSIER, 'grand', 'tete.webp'));
const img = (nom: string) => ({ petit: `${DOSSIER}petit/${nom}.webp`, grand: `${DOSSIER}grand/${nom}.webp` });
---
<section class="hm" aria-labelledby="hm-titre">
  <div class="hm-carte">
    <h1 id="hm-titre" class="hm-titre"><span class="hm-fin">Conçu à la main,</span> <span class="hm-gras">imprimé couche après couche</span></h1>
    <div class="hm-bas">
      <div class="hm-objet" aria-hidden="true">
        <div class="hm-cale" style={`aspect-ratio:${L}/${H}`}></div>
      </div>
      <div class="hm-texte">
        <p><strong>Kov Atelier</strong> modélise et imprime vos pièces sur mesure, du prototype à la pièce unique, à Florange.</p>
        <a class="btn btn-primary" href="/devis" data-cta="hero">Demander un devis <span aria-hidden="true">›</span></a>
        <a class="hm-lien" href="#realisations">Ou voir nos réalisations</a>
      </div>
    </div>
  </div>
  <div class="hm-fumee" aria-hidden="true">{FUMEE.map((f, i) => <span style={`--i:${i};left:${f[0]}%;top:${f[1]}%;--t:${f[2]}`}></span>)}</div>
  <div class="hm-ralenti" aria-hidden="true"></div>
  <!-- Deuxième structure : la tête à gauche (le masque vient s'y poser), le texte à droite -->
  <div class="hm-suite">
    <div class="hm-place" aria-hidden="true" style={`--ar-g:${G.tete[0]}/${G.tete[1]};--ar-p:${P.tete[0]}/${P.tete[1]}`}>
      {actif && ['tete-allumee', 'pose'].map((nom) => (
        <picture class="hm-img hm-fixe">
          <source media="(max-width: 799px)" srcset={img(nom).petit} />
          <img src={img(nom).grand} alt="" width={L} height={H} decoding="async" loading="lazy" />
        </picture>
      ))}
    </div>
    <div class="hm-suite-texte">
      <p class="hm-sur">Ce que fait l’atelier</p>
      <h2 class="hm-titre2"><span class="hm-fin">Modélisation, impression</span> <span class="hm-gras">et rétro-ingénierie</span></h2>
      <p>D’une photo, d’un plan ou d’une pièce cassée, l’atelier conçoit le modèle 3D puis l’imprime en résine ou en filament, selon l’usage.</p>
      <a class="hm-lien" href="/services">Voir les services <span aria-hidden="true">›</span></a>
    </div>
  </div>
  {actif && (
    <div class="hm-piste" aria-hidden="true">
      <div class="hm-scene" data-dossier={DOSSIER} data-n={N} data-cadre={G.cadre.join(',')} data-m0={G.m0.join(',')} data-cadre-p={P.cadre.join(',')} data-m0-p={P.m0.join(',')}>
        <div class="hm-zone">
          <span class="hm-brume">{[0, 1, 2, 3, 4, 5].map((i) => <span style={`--i:${i}`}></span>)}</span>
          {['tete', 'tete-allumee'].map((nom) => (
            <picture class={`hm-img hm-${nom}`}>
              <source media="(max-width: 799px)" srcset={img(nom).petit} />
              <img src={img(nom).grand} alt="" width={L} height={H} decoding="async" />
            </picture>
          ))}
        </div>
        <canvas class="hm-canvas"></canvas>
      </div>
    </div>
  )}
</section>
<script is:inline>
  (function () {
    var sc = document.querySelector('.hm-scene');
    if (!sc) return;
    var hero = sc.closest('.hm'), piste = sc.parentElement, cv = sc.querySelector('.hm-canvas'), zone = sc.querySelector('.hm-zone');
    var allumee = zone.querySelector('.hm-tete-allumee'), cale = hero.querySelector('.hm-cale'), place = hero.querySelector('.hm-place'), ral = hero.querySelector('.hm-ralenti');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { hero.classList.add('hm-reduit'); return; }
    var tel = innerWidth < 800, cx = cv.getContext('2d'), n = +sc.dataset.n, dos = sc.dataset.dossier + (tel ? 'petit/' : 'grand/');
    var CAD = (tel ? sc.dataset.cadreP : sc.dataset.cadre).split(',').map(Number), M0 = (tel ? sc.dataset.m0P : sc.dataset.m0).split(',').map(Number);
    var BITMAP = !!window.createImageBitmap;

    // ---- Images : chaque image est une vignette placée dans le cadre (vignettes.json) ----
    var V = null, blobs = [], src = [], enCours = [];
    function nom(i) { return dos + 'm' + ('00' + i).slice(-3) + '.webp'; }
    function charger(i, cb) {
      if (BITMAP) fetch(nom(i)).then(function (r) { return r.blob(); }).then(function (b) { blobs[i] = b; fenetre(); if (cb) cb(); }, function () { if (cb) cb(); });
      else { var im = new Image(); im.onload = function () { src[i] = im; forcer = true; demander(); if (cb) cb(); }; im.onerror = function () { if (cb) cb(); }; im.src = nom(i); }
    }
    // Décodage en arrière-plan des images autour de la position courante ; les autres sont libérées (mémoire)
    function fenetre() {
      if (!BITMAP) return;
      var c = Math.round(cur * (n - 1)), de = c - 10, a = c + 22;
      for (var i = Math.max(0, de); i <= Math.min(n - 1, a); i++) if (blobs[i] && !src[i] && !enCours[i]) (function (i) {
        enCours[i] = 1; createImageBitmap(blobs[i]).then(function (bm) { enCours[i] = 0; src[i] = bm; forcer = true; demander(); }, function () { enCours[i] = 0; });
      })(i);
      for (i = 0; i < n; i++) if (src[i] && (i < de - 6 || i > a + 6)) { if (src[i].close) src[i].close(); src[i] = null; }
    }
    function proche(i) { for (var d = 0; d < 24; d++) { if (src[i - d]) return i - d; if (src[i + d]) return i + d; } return -1; }
    var dessine = -1;
    function dessiner(f, force) {
      if (!V || (!force && Math.abs(f - dessine) < 0.02)) return;
      var i0 = Math.floor(f), i1 = Math.min(n - 1, i0 + 1), a = f - i0;
      var j0 = src[i0] ? i0 : proche(i0); if (j0 < 0) return;
      cx.clearRect(0, 0, cv.width, cv.height);
      if (src[i0] && src[i1] && a > 0.02 && i1 !== i0) {
        // fondu entre deux images voisines (addition exacte des deux, pondérées)
        cx.globalAlpha = 1 - a; cx.drawImage(src[i0], V[i0][0], V[i0][1]);
        cx.globalCompositeOperation = 'lighter'; cx.globalAlpha = a; cx.drawImage(src[i1], V[i1][0], V[i1][1]);
        cx.globalCompositeOperation = 'source-over'; cx.globalAlpha = 1;
      } else cx.drawImage(src[j0], V[j0][0], V[j0][1]);
      dessine = src[i0] ? f : -1;
    }
    fetch(dos + 'vignettes.json').then(function (r) { return r.json(); }).then(function (j) {
      V = j.v; cv.width = j.canvas[0]; cv.height = j.canvas[1];
      charger(0, function () { remesurer(); hero.classList.add('hm-pret'); });
      function lereste() {
        var ordre = [], vu = {};
        [8, 4, 2, 1].forEach(function (p) { for (var i = 0; i < n; i += p) if (!vu[i]) { vu[i] = 1; ordre.push(i); } });
        var k = 1; (function suite() { var lot = ordre.slice(k, k + 6); k += 6; var r = lot.length; if (!r) return;
          lot.forEach(function (i) { charger(i, function () { if (--r === 0) setTimeout(suite, 20); }); }); })();
      }
      if (document.readyState === 'complete') setTimeout(lereste, 150); else addEventListener('load', function () { setTimeout(lereste, 150); });
    });

    // ---- Géométrie : la scène (tête + masque) a la taille du cadre ; elle part du hero et se décolle sur la place ----
    var DEB = 0, FIN = 1, DX = 0, S0 = 1, largeur = innerWidth;
    function mesurer() {
      // défilement de la scène : environ 4 hauteurs d'écran (espace .hm-ralenti ajouté avant la tête)
      ral.style.height = '0px'; mesurer2(); var D0 = FIN - DEB;
      ral.style.height = Math.max(0, Math.round(4 * innerHeight - D0)) + 'px'; mesurer2();
    }
    function mesurer2() {
      var h = hero.getBoundingClientRect(), c = cale.getBoundingClientRect(), t = place.getBoundingClientRect();
      var Wc = t.width / CAD[2], Hc = t.height / CAD[3];
      var gauche = t.left - h.left - CAD[0] * Wc, pose = t.top - h.top - CAD[1] * Hc;   // position de la scène une fois posée
      var haut = c.top - h.top + c.height / 2 - M0[1] * Hc;                                // départ : masque au centre de la cale
      sc.style.width = Wc + 'px'; sc.style.height = Hc + 'px';
      zone.style.left = CAD[0] * Wc + 'px'; zone.style.top = CAD[1] * Hc + 'px'; zone.style.width = t.width + 'px'; zone.style.height = t.height + 'px';
      piste.style.left = gauche + 'px'; piste.style.width = Wc + 'px';
      piste.style.top = haut + 'px'; piste.style.height = Math.max(Hc, pose + Hc - haut) + 'px';
      sc.style.setProperty('--my', (M0[1] * Hc) + 'px');
      sc.style.transformOrigin = (M0[0] * Wc) + 'px ' + (M0[1] * Hc) + 'px';
      DX = (c.left + c.width / 2) - (h.left + gauche + M0[0] * Wc); S0 = c.width / Math.max(1, t.width);
      var T = parseFloat(getComputedStyle(sc).top) || innerHeight / 2 - M0[1] * Hc;
      FIN = Math.max(1, h.top + scrollY + pose - T);                    // la scène se décolle posée sur la place
      DEB = Math.min(FIN - 1, Math.max(0, h.top + scrollY + haut - T));  // l'animation démarre quand le masque atteint le milieu
    }

    // ---- Progression lissée : l'animation rattrape le défilement avec un léger amorti ----
    function lis(x) { return x <= 0 ? 0 : x >= 1 ? 1 : x * x * x * (x * (6 * x - 15) + 10); }
    var cur = 0, cible = 0, boucle = false, avant = 0, forcer = false;
    function lireCible() { cible = Math.max(0, Math.min(1, (scrollY - DEB) / (FIN - DEB))); }
    function appliquer(force) {
      var k = lis(cur / 0.28);
      sc.style.transform = 'translate3d(' + (DX * (1 - k)).toFixed(1) + 'px,0,0) scale(' + (S0 + (1 - S0) * k).toFixed(4) + ')';
      zone.style.opacity = lis((cur - 0.12) / 0.16).toFixed(3);              // la tête apparaît pendant le recul
      if (allumee) allumee.style.opacity = lis((cur - 0.6) / 0.25).toFixed(3); // la lumière monte par la gauche
      dessiner(cur * (n - 1), force);
    }
    function demander() { if (!boucle) { boucle = true; avant = performance.now(); requestAnimationFrame(pas); } }
    function pas(maintenant) {
      var dt = Math.min(64, maintenant - avant); avant = maintenant;
      var ecart = cible - cur;
      cur = Math.abs(ecart) < 0.0004 ? cible : cur + ecart * (1 - Math.pow(1 - 0.16, dt / 16.7));
      fenetre(); appliquer(forcer); forcer = false;
      if (cur !== cible) requestAnimationFrame(pas); else boucle = false;
    }
    function remesurer() { mesurer(); lireCible(); cur = cible; fenetre(); appliquer(true); }
    remesurer(); addEventListener('load', remesurer);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(remesurer);
    if (window.ResizeObserver) new ResizeObserver(function () { remesurer(); }).observe(cale);
    // iPhone/iPad : la barre d'adresse change la hauteur sans changer la largeur ; on ne remesure que si la largeur change
    addEventListener('resize', function () { if (innerWidth !== largeur) { largeur = innerWidth; remesurer(); } });
    addEventListener('scroll', function () { lireCible(); demander(); }, { passive: true });
  })();
</script>
