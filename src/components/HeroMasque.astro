---
// Hero de l'accueil : carte sombre, grand titre sur deux lignes (fine puis grasse), le masque sculpté de l'atelier
// à gauche et un texte court + devis à droite. Sous la fumée, une deuxième structure : « Ce que fait l'atelier »
// avec, à gauche, une tête encapuchonnée (rendu 3D) sur laquelle le masque vient se poser.
// Tout est en 3D (rendus pré-calculés, fond transparent, aucune bordure) : au défilement, le masque tournoie en gros plan,
// traverse la fumée en reculant, rejoint la tête et s'ajuste sur le bas du visage ; une lumière douce monte par la gauche.
// Le canvas du masque et l'image de la tête ont exactement le même cadrage : une fois le canvas posé sur la place,
// les deux restent alignés.
// Poids : images en deux tailles (ordinateur / téléphone), seule la première se charge à l'ouverture.
// Animations réduites : la tête masquée, sans mouvement.
import fs from 'node:fs';
import path from 'node:path';
const DOSSIER = '/accueil/pose-v3/';      // changer le nom du dossier à chaque nouvelle version (cache des navigateurs)
const N = 72;
const L = 880, H = 999;                    // taille des images « grand » (même cadrage pour le masque et la tête)
// Volutes de fumée : [gauche %, haut %, taille relative]
const FUMEE = [[-12, 30, 1.1], [2, 52, .8], [10, 18, 1.4], [22, 44, .9], [30, 24, 1.2], [40, 55, .75], [48, 30, 1.35], [58, 46, .9], [64, 16, 1.1], [72, 50, 1.25], [80, 28, .85], [88, 46, 1.3], [94, 20, .9], [-4, 62, 1]];
const actif = fs.existsSync(path.join(process.cwd(), 'public', DOSSIER, 'grand', 'm000.webp')) && fs.existsSync(path.join(process.cwd(), 'public', DOSSIER, 'grand', 'tete.webp'));
const img = (nom: string) => ({ petit: `${DOSSIER}petit/${nom}.webp`, grand: `${DOSSIER}grand/${nom}.webp` });
---
<section class="hm" aria-labelledby="hm-titre">
  <div class="hm-carte">
    <h1 id="hm-titre" class="hm-titre"><span class="hm-fin">Conçu à la main,</span> <span class="hm-gras">imprimé couche après couche</span></h1>
    <div class="hm-bas">
      <div class="hm-objet" aria-hidden="true">
        {actif && <canvas class="hm-canvas" width={L} height={H} data-dossier={DOSSIER} data-n={N}></canvas>}
      </div>
      <div class="hm-texte">
        <p><strong>Kov Atelier</strong> modélise et imprime vos pièces sur mesure, du prototype à la pièce unique, à Florange.</p>
        <a class="btn btn-primary" href="/devis" data-cta="hero">Demander un devis <span aria-hidden="true">›</span></a>
        <a class="hm-lien" href="#realisations">Ou voir nos réalisations</a>
      </div>
    </div>
  </div>
  <div class="hm-fumee" aria-hidden="true">{FUMEE.map((f, i) => <span style={`--i:${i};left:${f[0]}%;top:${f[1]}%;--t:${f[2]}`}></span>)}</div>
  <!-- Deuxième structure : la tête à gauche (le masque vient s'y poser), le texte à droite -->
  <div class="hm-suite">
    <div class="hm-place" aria-hidden="true" style={`aspect-ratio:${L}/${H}`}>
      <span class="hm-brume">{[0, 1, 2, 3, 4, 5].map((i) => <span style={`--i:${i}`}></span>)}</span>
      {actif && ['tete', 'tete-allumee', 'm071'].map((nom) => (
        <picture class={`hm-img hm-${nom}`}>
          <source media="(max-width: 799px)" srcset={img(nom).petit} />
          <img src={img(nom).grand} alt="" width={L} height={H} decoding="async" loading="lazy" />
        </picture>
      ))}
    </div>
    <div class="hm-suite-texte">
      <p class="hm-sur">Ce que fait l’atelier</p>
      <h2 class="hm-titre2"><span class="hm-fin">Modélisation, impression</span> <span class="hm-gras">et rétro-ingénierie</span></h2>
      <p>D’une photo, d’un plan ou d’une pièce cassée, l’atelier conçoit le modèle 3D puis l’imprime en résine ou en filament, selon l’usage.</p>
      <a class="hm-lien" href="/services">Voir les services <span aria-hidden="true">›</span></a>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var cv = document.querySelector('.hm-canvas');
    if (!cv) return;
    var hero = cv.closest('.hm'), objet = cv.parentElement, place = hero.querySelector('.hm-place'), allumee = place.querySelector('.hm-tete-allumee');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { hero.classList.add('hm-reduit'); return; }
    var cx = cv.getContext('2d'), n = +cv.dataset.n, dos = cv.dataset.dossier + (innerWidth < 800 ? 'petit/' : 'grand/');
    var imgs = new Array(n), dernier = -1;
    function nom(i) { return dos + 'm' + ('00' + i).slice(-3) + '.webp'; }
    function charger(i, cb) { var im = new Image(); im.decoding = 'async'; im.onload = function () { imgs[i] = im; if (cb) cb(); }; im.src = nom(i); }
    function proche(i) { for (var d = 0; d < n; d++) { if (imgs[i - d]) return imgs[i - d]; if (imgs[i + d]) return imgs[i + d]; } return null; }
    function dessiner(i, force) {
      if (i === dernier && !force) return;
      var im = proche(i); if (!im) return;
      if (cv.width !== im.naturalWidth) { cv.width = im.naturalWidth; cv.height = im.naturalHeight; }
      cx.clearRect(0, 0, cv.width, cv.height); cx.drawImage(im, 0, 0); dernier = imgs[i] ? i : -1;
    }
    // Première image tout de suite, les autres après le chargement de la page (une sur trois d'abord, puis le reste)
    charger(0, function () { mesurer(); maj(true); hero.classList.add('hm-pret'); });
    function lereste() {
      var ordre = []; for (var i = 1; i < n; i += 3) ordre.push(i); for (i = 1; i < n; i++) if ((i - 1) % 3) ordre.push(i);
      var k = 0; (function suite() { var lot = ordre.slice(k, k + 6); k += 6; var r = lot.length; if (!r) return;
        lot.forEach(function (j) { charger(j, function () { if (--r === 0) setTimeout(suite, 30); maj(true); }); }); })();
    }
    if (document.readyState === 'complete') setTimeout(lereste, 200); else addEventListener('load', function () { setTimeout(lereste, 200); });

    // Le canvas (même cadrage que l'image de la tête) rejoint exactement la place de la tête, à la même taille.
    var FIN = 1;
    function mesurer() {
      objet.style.setProperty('--p', '0');
      var ob = objet.getBoundingClientRect(), o = cv.getBoundingClientRect(), t = place.getBoundingClientRect();
      objet.style.transformOrigin = (o.left - ob.left) + 'px ' + (o.top - ob.top) + 'px';
      objet.style.setProperty('--dx', Math.round(t.left - o.left) + 'px');
      objet.style.setProperty('--d', Math.round(t.top - o.top) + 'px');
      objet.style.setProperty('--s', (t.width / Math.max(1, o.width)).toFixed(4));
      FIN = Math.max(innerHeight * 0.5, t.top + scrollY + t.height / 2 - innerHeight / 2);   // trajet minimal d'une demi-hauteur d'écran
    }
    function lis(x) { return x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x); }
    function maj(force) {
      var P = Math.max(0, Math.min(1, scrollY / FIN));
      // le masque avance image par image sur tout le trajet ; le canvas rejoint la tête à 65 % du trajet
      dessiner(Math.round(P * (n - 1)), force);
      objet.style.setProperty('--p', lis(P / 0.65).toFixed(4));
      if (allumee) allumee.style.opacity = lis((P - 0.45) / 0.55).toFixed(3);
    }
    mesurer(); addEventListener('resize', function () { mesurer(); maj(true); }); addEventListener('load', function () { mesurer(); maj(true); });
    var attente = false;
    addEventListener('scroll', function () { if (attente) return; attente = true; requestAnimationFrame(function () { attente = false; maj(false); }); }, { passive: true });
  })();
</script>
